{
  "name": "openfox-autonomous-playwright",
  "version": "0.1.0",
  "description": "OpenFox plugin launching parallel Playwright agents for bug-hunting, FAQ and documentation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall-playwright.mjs"
  },
  "openfox": {
    "apiVersion": 2,
    "entry": "./dist/index.js",
    "displayName": "Autonomous Playwright",
    "description": "Lance N agents Playwright parallèles pour bug-hunt, FAQ et documentation.",
    "capabilities": [
      "tools",
      "commands",
      "skills",
      "settings",
      "rpc",
      "ui",
      "hooks",
      "notifications",
      "assets",
      "workflows"
    ],
    "timeoutMs": 30000
  },
  "peerDependencies": {
    "openfox": ">=2.0.140"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
